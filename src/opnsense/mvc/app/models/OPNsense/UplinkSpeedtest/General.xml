<model>
    <mount>//OPNsense/UplinkSpeedtest/general</mount>
    <version>1.1.0</version>
    <description>Uplink speedtest settings</description>
    <items>
        <provider type="OptionField">
            <default>cloudflare</default>
            <Required>Y</Required>
            <OptionValues>
                <cloudflare>Cloudflare (speed.cloudflare.com)</cloudflare>
                <ookla>Ookla (speedtest.net)</ookla>
                <iperf3>iperf3</iperf3>
            </OptionValues>
            <ValidationMessage>Choose Cloudflare, Ookla or iperf3.</ValidationMessage>
        </provider>
        <server type="TextField">
            <Mask>/^[0-9]{0,8}$/</Mask>
            <ValidationMessage>Enter a numeric speedtest.net server ID, or leave empty to use the nearest server.</ValidationMessage>
        </server>
        <iperf3_server type="HostnameField">
            <default>fra.speedtest.clouvider.net</default>
            <IpAllowed>Y</IpAllowed>
            <ValidationMessage>Enter the hostname or IP address of an iperf3 server.</ValidationMessage>
        </iperf3_server>
        <iperf3_port type="PortField">
            <default>5200</default>
            <EnableWellKnown>Y</EnableWellKnown>
            <ValidationMessage>Enter the TCP port the iperf3 server listens on.</ValidationMessage>
        </iperf3_port>
        <iperf3_streams type="IntegerField">
            <default>4</default>
            <MinimumValue>1</MinimumValue>
            <MaximumValue>16</MaximumValue>
            <ValidationMessage>Enter 1 to 16 parallel streams.</ValidationMessage>
        </iperf3_streams>
    </items>
</model>
